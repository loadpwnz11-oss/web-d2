```gitignore
# Environment files
.env
.env.local
*.env.*

# Logs and temporary files
*.log
*.tmp

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# Dependencies
node_modules/
vendor/

# Build artifacts
dist/
build/
*.phar

# Database
*.sql

# Cache
.cache/
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db
```